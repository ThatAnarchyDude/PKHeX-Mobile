<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <ApplicationTitle>PKHeX Mobile</ApplicationTitle>
    <ApplicationId>com.corvus.pkhexmobile</ApplicationId>
    <ApplicationDisplayVersion>0.31</ApplicationDisplayVersion>
    <ApplicationVersion>31</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled PKHeX sprite art, read at runtime via FileSystem.OpenAppPackageFileAsync("sprites/...") -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <PropertyGroup>
    <!-- The core and Auto-Legality library come from a sibling clone of PKHeX-Psyduck-Yellow (tag pkhex-psyduck-yellow-v5, see README) -->
    <PsyduckYellowCoreProject>$(MSBuildThisFileDirectory)..\PKHeX-Psyduck-Yellow\PKHeX.Core\PKHeX.Core.csproj</PsyduckYellowCoreProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PKHeX-Psyduck-Yellow\PKHeX.Core\PKHeX.Core.csproj" />
    <ProjectReference Include="..\PKHeX-Psyduck-Yellow\Auto-Legality-Mod\PKHeX.Core.AutoMod\PKHeX.Core.AutoMod.csproj" />
  </ItemGroup>
</Project>
